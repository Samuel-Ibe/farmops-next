# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report/
/test-results/
/playwright/.cache/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local run logs (dev server + docker build)
dev-server.log
dev-server.err.log
docker-build.log
docker-build.err

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# prisma
# NOTE: prisma/migrations is version-controlled (roadmap Phase 3 — versioned
# schema evolution). Only generated client output is ignored.

# typescript
*.tsbuildinfo
next-env.d.ts
